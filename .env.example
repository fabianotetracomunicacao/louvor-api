VITE_SUPABASE_URL=your_project_url_here
VITE_SUPABASE_ANON_KEY=your_anon_key_here

VITE_SITE_URL=http://localhost:5173

# Public base URL used by the browser for artist suggestions and catalog lookup.
# Keep the /api suffix: the client calls /artists/* below this URL.
VITE_CIFRA_API_URL=http://localhost:3000/api

# Server-only Edge Function configuration. Set these as Supabase Function
# secrets; do not prefix them with VITE_ and do not commit production values.
# The catalog endpoint lives below /api, while the individual cifra endpoint
# lives at the API root.
CIFRA_CATALOG_API_URL=http://localhost:3000/api
CIFRA_DETAIL_API_URL=http://localhost:3000
